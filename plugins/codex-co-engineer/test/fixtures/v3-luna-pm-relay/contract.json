{
  "schema": "codex-co-engineer.taskport.v1",
  "version": 1,
  "default_model": "luna-max",
  "host_task_tools": ["create_thread", "send_message_to_thread", "wait_threads", "read_thread"],
  "wake_events": [
    "completed",
    "blocked",
    "failed",
    "question",
    "timeout",
    "user_update",
    "merge_ready"
  ],
  "sol_escalation_criteria": [
    "conflicting_exact_evidence_or_reviewer_verdicts",
    "security_or_protected_ref_risk",
    "composition_ambiguity",
    "repeated_deterministic_rejection",
    "release_authority_decision",
    "explicit_user_escalation"
  ],
  "sol_adjudicator": ["sol-high", "sol-xhigh"],
  "sol_medium_mandatory": false,
  "degraded_mode": "current_codex_task",
  "native_subagent_role": "local_analysis",
  "never_wake_sol_on": "completed",
  "host_executor": "codex_skill",
  "wait_threads_target": {
    "required": ["threadId"],
    "optional": ["hostId", "afterCursor"]
  }
}
